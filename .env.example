# Copia este archivo a .env y rellena los valores (nunca subas .env al repositorio)

TELEGRAM_BOT_TOKEN=paste_token_from_botfather
ANTHROPIC_API_KEY=paste_key_from_anthropic_console
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1
VOICE_SHOW_TRANSCRIPTION=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
ATLAS_VITAL_URL=https://your-atlas-vital-url
ASSISTANT_API_KEY=paste_assistant_api_key
DEFAULT_CURRENCY=CHF
ENABLE_DAILY_AUTOMATIONS=true
AUTOMATION_TIMEZONE=Europe/Zurich
MORNING_BRIEF_TIME=07:30
NIGHT_RECAP_TIME=21:30
DAILY_REVIEW_URL=https://your-atlas-vital-url/review/daily

# Tiering de modelos (ruta agente): Haiku por defecto, Sonnet cuando hace falta profundidad
MODEL_FAST=claude-haiku-4-5
MODEL_SMART=claude-sonnet-4-5
# Mensajes > N palabras o con keywords reflexivas escalan a MODEL_SMART (coach siempre Sonnet)
REFLECTIVE_WORD_THRESHOLD=80
# REFLECTIVE_KEYWORDS=por qué,siento,revisión,analiza,ayúdame a pensar

# UX Telegram: renovar "escribiendo…" y mensaje provisional si tarda
TYPING_RENEWAL_SECONDS=4.5
PROVISIONAL_REPLY_DELAY_SECONDS=8
PROVISIONAL_REPLY_TEXT=Dame un segundo…

# Memoria conversacional: truncar resumen inyectado en system prompt (~tokens)
MAX_MEMORY_SUMMARY_CHARS=2000

# Nombre del titular del asistente (sustituye [tu nombre] en el system prompt)
OWNER_NAME=Tu Nombre
