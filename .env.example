# Copia este archivo a .env y rellena los valores (nunca subas .env al repositorio)

TELEGRAM_BOT_TOKEN=paste_token_from_botfather
ANTHROPIC_API_KEY=paste_key_from_anthropic_console
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
ATLAS_VITAL_URL=https://your-atlas-vital-url
ASSISTANT_API_KEY=paste_assistant_api_key
DEFAULT_CURRENCY=CHF
ENABLE_DAILY_AUTOMATIONS=true
AUTOMATION_TIMEZONE=Europe/Zurich
MORNING_BRIEF_TIME=07:30
NIGHT_RECAP_TIME=21:30
DAILY_REVIEW_URL=https://your-atlas-vital-url/review/daily

# Nombre del titular del asistente (sustituye [tu nombre] en el system prompt)
OWNER_NAME=Tu Nombre
